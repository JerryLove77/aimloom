{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aimloom",
  "version": "0.1.5",
  "identifier": "com.aimloom.app",
  "build": {
    "frontendDist": "../dist-installer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:installer",
    "beforeBuildCommand": "npm run build:installer"
  },
  "app": {
    "windows": [
      {
        "label": "installer",
        "title": "Aimloom",
        "url": "installer.html",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": [
        "installer"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
