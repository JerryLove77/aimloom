{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["astro/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests", "vitest.config.ts", "scripts"],
  "exclude": ["src/worker", "tests-worker", "vitest.workers.config.ts"]
}
