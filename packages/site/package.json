{
  "name": "@kvk/site",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:worker": "vitest run -c vitest.workers.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/worker/tsconfig.json",
    "deploy": "astro build && node scripts/stage-release.mjs && node scripts/wrangler-config.mjs && wrangler deploy --config .wrangler.generated.jsonc --env=\"\"",
    "deploy:preview": "astro build && node scripts/stage-release.mjs && node scripts/wrangler-config.mjs && wrangler deploy --config .wrangler.generated.jsonc --env preview",
    "check:links": "node scripts/check-links.mjs dist",
    "check:a11y": "node scripts/check-a11y.mjs dist",
    "stage:release": "node scripts/stage-release.mjs",
    "release:upload": "node scripts/release-upload.mjs",
    "wrangler-config": "node scripts/wrangler-config.mjs",
    "report": "node scripts/wrangler-config.mjs && node scripts/report.mjs",
    "reports": "node scripts/wrangler-config.mjs && node scripts/report.mjs --list",
    "site:publish": "tsx scripts/publish.ts",
    "site:backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "^5.5.0",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  }
}
